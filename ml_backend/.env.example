DATABASE_URL=postgresql://estateai:change-this-password@localhost:5432/estateai
POSTGRES_DB=estateai
POSTGRES_USER=estateai
POSTGRES_PASSWORD=change-this-password

# Generate different random secrets for each key before running the API.
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
