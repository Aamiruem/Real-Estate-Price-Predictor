# Leave these unset in development: Vite proxies /api to the FastAPI service
# (port 8001) and /ai to the RAG assistant (port 8002), so auth cookies stay
# first-party. Set them only when the frontend is served from another origin.
# VITE_API_URL=http://localhost:8001
# VITE_RAG_API_URL=http://localhost:8002
